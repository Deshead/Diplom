# Локальная разработка: SQLite, письма в терминале, задачи без Redis.
DJANGO_DEBUG=true
# Одинарные кавычки защищают знак $ в ключе от подстановки Docker Compose.
SECRET_KEY='local-development-only-change-before-deploying'
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=orders@example.com
ADMIN_EMAIL=admin@example.com

CELERY_TASK_ALWAYS_EAGER=true
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Docker Compose использует эти значения для учебной базы PostgreSQL.
# Пока POSTGRES_HOST не указан, локальный Django работает с SQLite.
POSTGRES_DB=orders
POSTGRES_USER=orders
POSTGRES_PASSWORD=orders_local_password
